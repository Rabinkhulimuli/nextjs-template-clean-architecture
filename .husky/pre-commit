
BRANCH_NAME=$(git symbolic-ref --short HEAD)

BRANCH_REGEX="^(features|revisions|hotfix|chore)\/(rk|client|pg)-[a-z0-9]+(-[a-z0-9]+)*$"

if ! echo "$BRANCH_NAME" | grep -Eq "$BRANCH_REGEX"; then
  echo "❌ Invalid branch name:"
  echo "   $BRANCH_NAME"
  echo ""
  echo "✅ Expected format:"
  echo "   type/scope-kebab-case"
  echo ""
  echo "📌 Example:"
  echo "   features/rk-add-coupon-component"
  exit 1
fi

echo "🔍 Running lint-staged on staged files..."
pnpm lint-staged

if [ $? -ne 0 ]; then
  echo "❌ Lint-staged check failed"
  exit 1
fi

echo "✅ Pre-commit checks passed"
